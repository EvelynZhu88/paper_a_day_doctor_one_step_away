# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit it.

# === Supabase ===
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
# Service role key — server-side only. Has full DB access. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# === Hugging Face (for free embeddings) ===
# Sign up at huggingface.co → Settings → Access Tokens → New token (read scope is enough)
HUGGINGFACE_API_KEY=hf_...your-token...

# === Cron secret ===
# Any random string — used to authenticate Vercel cron calls.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=replace-me-with-random-hex-string
